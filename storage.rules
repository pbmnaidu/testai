rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Team ALA scoped uploads (evidence and attendance)
    match /team_ala/{folder}/{work_id}/{filename} {
      allow read: if true;
      allow write: if request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Evidence photos uploaded by citizens or officers
    match /evidence/{work_id}/{filename} {
      allow read: if true;
      allow write: if request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Attendance camera captures
    match /attendance/{work_id}/{filename} {
      allow read: if true;
      allow write: if request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Default allow read for public files, require auth for write
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
