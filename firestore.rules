rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Citizen evidence submissions
    match /citizen_evidence/{submissionId} {
      // Allow reading evidence metadata
      allow read: if true;
      
      // Allow creating new evidence documents
      allow create: if request.resource.data.work_id is string
        && request.resource.data.download_url is string
        && request.resource.data.byte_size is number;
        
      // Allow updating review status (officer review)
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review_status', 'reviewed_by', 'reviewed_at', 'review_comment', 'updated_at']);
        
      allow delete: if false;
    }

    // Staff attendance records
    match /attendance_records/{attendanceId} {
      allow read: if true;
      
      allow create: if request.resource.data.work_id is string
        && request.resource.data.download_url is string;
        
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Material Quality & Price Fairness Assessments
    match /material_assessments/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Default: allow read for public data, write if authenticated
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
