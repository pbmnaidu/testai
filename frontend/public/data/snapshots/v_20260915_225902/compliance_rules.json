    {
      "rule_id": "C_SANCTION_TIMING",
      "rule_name": "Sanction or rejection timing",
      "guideline_name": "MPLADS Guidelines (April 1, 2023, including amendments)",
      "guideline_section": "Para 3.2.4",
      "source_document": "mplads_2023_guidelines_including_changes.pdf",
      "scope": "WORK",
      "rule_interpretation": "Sanction or rejection must be issued within 45 days of receiving a recommendation.",
      "required_data_fields": [
        "recommended_date",
        "sanction_date"
      ],
      "threshold": "45 days",
      "implementation_decision": "KEEP_AND_MODIFY"
    },
    {
      "rule_id": "C_MINIMUM_SANCTION",
      "rule_name": "Normal minimum sanctioned amount",
      "guideline_name": "MPLADS Guidelines (April 1, 2023, including amendments)",
      "guideline_section": "Para 3.2.9",
      "source_document": "mplads_2023_guidelines_including_changes.pdf",
      "scope": "WORK",
      "rule_interpretation": "An individual work is normally sanctioned for at least Rs. 2.5 lakh; a lower amount requires reasons in the sanction letter.",
      "required_data_fields": [
        "sanction_amount"
      ],
      "threshold": "Rs. 2.5 lakh normally",
      "implementation_decision": "MODIFY_TO_NEEDS_REVIEW"
    },
    {
      "rule_id": "C_COMPLETION_PERIOD_REVIEW",
      "rule_name": "Completion period in sanction letter",
      "guideline_name": "MPLADS Guidelines (April 1, 2023, including amendments)",
      "guideline_section": "Para 3.2.12",
      "source_document": "mplads_2023_guidelines_including_changes.pdf",
      "scope": "WORK",
      "rule_interpretation": "The sanction letter should generally set a completion period not exceeding one year, with specific justification for exceptions.",
      "required_data_fields": [
        "sanction_date",
        "completion_date",
        "work_status"
      ],
      "threshold": "Generally not more than one year",
      "implementation_decision": "MODIFY_TO_NEEDS_REVIEW"
    },
