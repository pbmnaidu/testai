      "rule_id": "C_FRAUD_DUPLICATE_EVIDENCE",
      "rule_name": "Cross-work duplicate evidence / location reuse",
      "guideline_name": "MPLADS Guidelines (April 1, 2023, including amendments)",
      "guideline_section": "Para 9.1 & Forensic Audit",
      "source_document": "mplads_2023_guidelines_including_changes.pdf",
      "scope": "WORK",
      "rule_interpretation": "Evidence reuse across separate works is prohibited. Identical photos, files, or geotagged coordinates across different projects constitute suspected fraud.",
