      "guideline_name": "MPLADS Guidelines (April 1, 2023, including amendments)",
      "guideline_section": "Para 8.12.1",
      "source_document": "mplads_2023_guidelines_including_changes.pdf",
      "scope": "WORK",
      "rule_interpretation": "Rehabilitation works for a calamity are to be completed within 18 months of approval.",
      "required_data_fields": [
        "sanction_date",
        "completion_date",
        "description"
      ],
      "threshold": "18 months",
      "implementation_decision": "ADD_WHEN_CALAMITY_EVIDENCE_EXISTS"
